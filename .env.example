# 把这个文件复制成 .env 再填。填完就够了，不用每次开 shell 设 $env:。
#
# qqbot 包在导入时自动读 .env：从当前目录往上找最近的一处，也可以用
# QQBOT_ENV_FILE 指定别的路径。进程里已经有的真环境变量优先，临时覆盖照样管用。
#
# 密钥不必写在这里。<NAME>_FILE 指向一个文件，<NAME> 会自动取那个文件的内容。
# 比如把 DEEPSEEK_KEY_FILE 指向 deepseek.txt，key 就留在原来的地方。
#
# 填完跑 `python -m qqbot` 看一眼读到了什么；它只报长度，不打印密钥。
# 日常启动双击根目录的 start_ui.bat（等于 `python -m qqbot start`）：
# 同步 NapCat 配置 -> 起 web -> 在新窗口起 NapCat，顺序和端口都不用管。

# NapCat.Shell 的目录。设了它就不用再手抄 NapCat 的东西：
#   - OneBot 地址和 token 直接从 NapCat 的 httpServers 读；
#   - 推送地址（下面的 web 端口）和事件 token 自动写进 NapCat 的 httpClients；
#   - 事件 token 第一次启动时自动生成，存在 QQBOT_EVENT_TOKEN_FILE。
NAPCAT_DIR=D:\projects\NapCat.Shell
# NapCat 里登过多个号时用它指定；设了还会快速登录（免扫码）。
# NAPCAT_UIN=123456789

# 拟人聊天交给麦麦（MaiBot）。设了 MAIBOT_DIR，启动时会：
#   - 在 NapCat 里开一个只听本机的正向 WebSocket（端口见下），给麦麦的 NapCat 适配器连，
#     它的 token 自动生成在 config/api/maibot_napcat_ws.txt；
#   - 生成麦麦插件调用本服务用的 token（QQBOT_PLUGIN_TOKEN_FILE）。
# 麦麦会在独立窗口启动；已有 WebUI 响应时不重复启动。
MAIBOT_DIR=D:\projects\MaiBot
MAIBOT_NAPCAT_WS_PORT=3001
QQBOT_PLUGIN_TOKEN_FILE=config/api/qqbot_plugin.txt

DEEPSEEK_API_KEY=sk-xxx
# 只想让 key 留在文件里，就把上面那行删掉，用这行指路：
# DEEPSEEK_KEY_FILE=D:\重要的资料\身份认证和各种key\deepseek.txt
# 没设 NAPCAT_DIR 时才需要手填这两项：
# ONEBOT_ENDPOINT=http://127.0.0.1:3000
# ONEBOT_ACCESS_TOKEN_FILE=D:\重要的资料\身份认证和各种key\onebot.txt
# OneBot 请求超时（秒）；大群文件下载可临时提高到 300
# QQBOT_ONEBOT_TIMEOUT=60
# NapCat 推群消息时签名用的 token。设了 NAPCAT_DIR 就自动生成并同步，不用管。
QQBOT_EVENT_TOKEN_FILE=config/api/qqbot_event.txt
QQBOT_WEB_HOST=127.0.0.1
# 别用 8787：开了 Hyper-V/WSL 的 Windows 常把它划进保留区间，绑定报 WinError 10013。
# 改端口只改这里，下次启动 NapCat 那边会自动跟着改。
QQBOT_WEB_PORT=18787

# 只认这里的 QQ 号是管理员（逗号分隔）。群主、群管理、消息里自称管理员都不算。
QQBOT_ADMIN_IDS=10001
# 服务哪些群（逗号分隔）。/毯 任务和麦麦插件的查询都只在这些群里生效。
# 留空时退回到「收到过消息的群」，建议填上。
QQBOT_GROUPS=100000001

# /毯 任务用的模型。别依赖 deepseek-chat 等旧名。
QQBOT_MODEL=deepseek-flash
# 整理技巧时判断消息类别用的模型。
QQBOT_JUDGE_MODEL=deepseek-flash
# 思考深度原样传给接口：官方档位 low/high/max，medium 按 high 算；none 关掉思考。
QQBOT_REASONING_EFFORT=low
QQBOT_JUDGE_REASONING_EFFORT=low
# 实测 max_tokens 把思考也算进去，所以开思考时实际发给接口的
# max_tokens = 回答长度 + 这个预算。思考用的 token 也计费。
# 还是报「思考过程把 token 用完了」就调大。
QQBOT_THINKING_BUDGET=4000
# /毯 任务回答的长度（不含思考）和最多几轮工具调用。
QQBOT_TASK_MAX_TOKENS=800
QQBOT_TOOL_ROUNDS=4
# 普通群员在这个时间窗（秒）里最多发起几个 /毯 任务；管理员不限。
QQBOT_TASK_WINDOW=600
QQBOT_TASK_LIMIT=5
QQBOT_TOOL_MAX_ITEMS=20
QQBOT_TOOL_MAX_CHARS=12000
QQBOT_REPLY_CONTEXT_CHARS=3000
QQBOT_IMAGE_FILE_TTL=86400

# 群图片的本地缓存。QQ 图片链接几小时就过期，web 收到消息时就下载到这里。
QQBOT_IMAGE_DIR=runtime/private/qq_images
QQBOT_DB=runtime/private/qqbot.db
QQBOT_TRICKS_DIR=runtime/private/qq_tricks
QQBOT_ESSENCE_SYNC_MINUTES=60
# QQ 自动恢复不使用模型。连续离线后先尝试上线，再重启 NapCat 并用账号缓存登录。
QQBOT_AUTO_RECOVERY=true
QQBOT_RECOVERY_OFFLINE_SECONDS=90
QQBOT_RECOVERY_RESTART_COOLDOWN=300
QQBOT_RECOVERY_MAX_RESTARTS=3
# 技术研究条目导出的 Wiki 根目录。
UNDERLINE_WIKI_ROOT=../underline_wiki
QQBOT_WORKSPACES_DIR=runtime/private/agent_workspaces
# 搜索接口须返回 RSS；查询词经过 URL 编码后追加到末尾。
QQBOT_SEARCH_URL=https://www.bing.com/search?format=rss&q=
