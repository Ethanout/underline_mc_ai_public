# 把这个文件复制成 .env 再填。填完就够了，不用每次开 shell 设 $env:。
#
# qqbot 包在导入时自动读 .env：从当前目录往上找最近的一处，也可以用
# QQBOT_ENV_FILE 指定别的路径。进程里已经有的真环境变量优先，临时覆盖照样管用。
#
# 密钥不必写在这里。<NAME>_FILE 指向一个文件，<NAME> 会自动取那个文件的内容。
# 比如把 QQBOT_EMBED_API_KEY_FILE 指向 silicon.txt，key 就留在原来的地方。
#
# 填完跑 `python -m qqbot.settings` 看一眼读到了什么；它只报长度，不打印密钥。

DEEPSEEK_API_KEY=sk-xxx
# 只想让 key 留在文件里，就把上面那行删掉，用这行指路：
# DEEPSEEK_KEY_FILE=D:\重要的资料\身份认证和各种key\deepseek.txt
ONEBOT_ACCESS_TOKEN=replace-me
# ONEBOT_ACCESS_TOKEN_FILE=D:\重要的资料\身份认证和各种key\onebot.txt
QQBOT_WEB_HOST=127.0.0.1
QQBOT_WEB_PORT=8787
QQBOT_REPLY_COOLDOWN=1
QQBOT_REPLY_MAX_TOKENS=220
QQBOT_REPLY_CONTEXT_CHARS=3000
# Future wiki integration; not consumed by the current exporter.
UNDERLINE_WIKI_ROOT=../underline_wiki

# 风格记忆：把群消息变成可检索的向量。
# api = 走 OpenAI 兼容的 /embeddings 接口（默认）；local = 本机 CPU 跑 bge-m3，不占显存。
QQBOT_EMBED_BACKEND=api
QQBOT_EMBED_BASE_URL=https://api.siliconflow.cn/v1
QQBOT_EMBED_API_KEY=sk-xxx
# 让 key 留在原文件里就不填上面那行，改成指路：
# QQBOT_EMBED_API_KEY_FILE=D:\重要的资料\身份认证和各种key\silicon.txt
# api 后端默认 Qwen3-VL-Embedding-8B（4096 维）。local 后端填它会在本机加载 8B，
# 改用 local 时把这行换回 BAAI/bge-m3。换模型就要清掉 QQBOT_STYLE_DB 重建。
QQBOT_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
# 仅在 QQBOT_EMBED_BACKEND=local 时生效。建议保持 cpu，把显卡留给别的活。
QQBOT_EMBED_DEVICE=cpu
QQBOT_STYLE_DB=runtime/private/qq_style
