# 把这个文件复制成 .env 再填。填完就够了，不用每次开 shell 设 $env:。
#
# qqbot 包在导入时自动读 .env：从当前目录往上找最近的一处，也可以用
# QQBOT_ENV_FILE 指定别的路径。进程里已经有的真环境变量优先，临时覆盖照样管用。
#
# 密钥不必写在这里。<NAME>_FILE 指向一个文件，<NAME> 会自动取那个文件的内容。
# 比如把 QQBOT_EMBED_API_KEY_FILE 指向 silicon.txt，key 就留在原来的地方。
#
# 填完跑 `python -m qqbot` 看一眼读到了什么；它只报长度，不打印密钥。
# 日常启动双击根目录的 start_ui.bat（等于 `python -m qqbot start`）：
# 同步 NapCat 配置 -> 起 web -> 在新窗口起 NapCat，顺序和端口都不用管。

# NapCat.Shell 的目录。设了它就不用再手抄 NapCat 的东西：
#   - OneBot 地址和 token 直接从 NapCat 的 httpServers 读；
#   - 推送地址（下面的 web 端口）和事件 token 自动写进 NapCat 的 httpClients；
#   - 事件 token 第一次启动时自动生成，存在 QQBOT_EVENT_TOKEN_FILE。
NAPCAT_DIR=D:\projects\NapCat.Shell
# NapCat 里登过多个号时用它指定；设了还会快速登录（免扫码）。
# NAPCAT_UIN=123456789

DEEPSEEK_API_KEY=sk-xxx
# 只想让 key 留在文件里，就把上面那行删掉，用这行指路：
# DEEPSEEK_KEY_FILE=D:\重要的资料\身份认证和各种key\deepseek.txt
# 没设 NAPCAT_DIR 时才需要手填这两项：
# ONEBOT_ENDPOINT=http://127.0.0.1:3000
# ONEBOT_ACCESS_TOKEN_FILE=D:\重要的资料\身份认证和各种key\onebot.txt
# NapCat 推群消息时签名用的 token。设了 NAPCAT_DIR 就自动生成并同步，不用管。
QQBOT_EVENT_TOKEN_FILE=config/api/qqbot_event.txt
QQBOT_WEB_HOST=127.0.0.1
# 别用 8787：开了 Hyper-V/WSL 的 Windows 常把它划进保留区间，绑定报 WinError 10013。
# 改端口只改这里，下次启动 NapCat 那边会自动跟着改。
QQBOT_WEB_PORT=18787
QQBOT_REPLY_COOLDOWN=1
QQBOT_REPLY_MAX_TOKENS=220
QQBOT_REPLY_CONTEXT_CHARS=3000
# 回复和判断都默认 deepseek-flash（支持看图）。别依赖 deepseek-chat 等旧名。
QQBOT_MODEL=deepseek-flash
QQBOT_JUDGE_MODEL=deepseek-flash
# 思考深度原样传给接口：官方档位 low/high/max，medium 按 high 算；none 关掉思考。
QQBOT_REASONING_EFFORT=low
QQBOT_JUDGE_REASONING_EFFORT=low
# 实测 max_tokens 把思考也算进去：回复长度 220 时，稍难的问题会被思考用完，正文为空。
# 所以开思考时，实际发给接口的 max_tokens = 回复长度 + 这个预算。思考用的 token 也计费。
# 实测 low 档一道小计算题用了 900–2500。还是报「思考过程把 token 用完了」就调大。
QQBOT_THINKING_BUDGET=4000
QQBOT_IMAGE_FILE_TTL=86400
QQBOT_ADMIN_IDS=10001
# Future wiki integration; not consumed by the current exporter.
UNDERLINE_WIKI_ROOT=../underline_wiki

# 风格记忆：把群消息变成可检索的向量。
# api = 走 OpenAI 兼容的 /embeddings 接口（默认）；local = 本机 CPU 跑 bge-m3，不占显存。
QQBOT_EMBED_BACKEND=api
QQBOT_EMBED_BASE_URL=https://api.siliconflow.cn/v1
QQBOT_EMBED_API_KEY=sk-xxx
# 让 key 留在原文件里就不填上面那行，改成指路：
# QQBOT_EMBED_API_KEY_FILE=D:\重要的资料\身份认证和各种key\silicon.txt
# api 后端默认 Qwen3-VL-Embedding-8B（4096 维）。local 后端填它会在本机加载 8B，
# 改用 local 时把这行换回 BAAI/bge-m3。换模型就要清掉 QQBOT_STYLE_DB 重建。
QQBOT_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
# 仅在 QQBOT_EMBED_BACKEND=local 时生效。建议保持 cpu，把显卡留给别的活。
QQBOT_EMBED_DEVICE=cpu
QQBOT_STYLE_DB=runtime/private/qq_style
# 回复时从风格记忆里检索多少条相似句作为语气参考。0 = 不用风格记忆。
QQBOT_STYLE_REPLY_K=5
# 群图片的本地缓存。QQ 图片链接几小时就过期，web 收到消息时就下载到这里，入库时读这份。
# 只有 api 后端的 VL 模型（如上面的 Qwen3-VL）能把图片入库；local 的 bge-m3 只认文字。
QQBOT_IMAGE_DIR=runtime/private/qq_images
QQBOT_DB=runtime/private/qqbot.db
QQBOT_TOOL_ROUNDS=3
QQBOT_MEMORY_INGEST_MINUTES=30
QQBOT_PROACTIVE_GROUPS=
QQBOT_PROACTIVE_MIN_GAP=120
QQBOT_PROACTIVE_MAX_PER_HOUR=6
QQBOT_TOOL_MAX_ITEMS=20
QQBOT_TOOL_MAX_CHARS=12000
QQBOT_TRICKS_DIR=runtime/private/qq_tricks
QQBOT_ESSENCE_SYNC_MINUTES=60
QQBOT_MEMORY_SLEEP_MINUTES=60
QQBOT_STYLE_NOTES_HOURS=24
QQBOT_ACTIVE_MIN_SECONDS=300
QQBOT_ACTIVE_MAX_SECONDS=1200
QQBOT_JUDGE_THRESHOLD=0.5
QQBOT_PROFILE_HALF_LIFE=2592000
QQBOT_EMOTION_HALF_LIFE=1800
QQBOT_MENTION_WEIGHT=3
QQBOT_PICKUP_SCALE=0.01
QQBOT_BASELINE_EXCITEMENT=0.5
QQBOT_BASELINE_MOOD=0.5
QQBOT_BASELINE_INTEREST=0.5
QQBOT_BASELINE_ENERGY=0.5
QQBOT_BASELINE_IRRITATION=0.5
QQBOT_BASELINE_CLOSENESS=0.5

# Cognitive-inspired scores use seconds for strength and elapsed time.
QQBOT_MEMORY_INITIAL_STRENGTH=86400
QQBOT_MEMORY_DECAY=0.5
QQBOT_MEMORY_RETRIEVAL_THRESHOLD=0.1
QQBOT_MEMORY_MATCH_THRESHOLD=0.4
QQBOT_MEMORY_ACTIVATION_HALF_LIFE=3600
QQBOT_MEMORY_HIT_GAIN=0.15
QQBOT_MEMORY_REINFORCEMENT_GAIN=3600
QQBOT_MEMORY_SPACING_SCALE=86400
QQBOT_MEMORY_REPEAT_WINDOW=600
QQBOT_MEMORY_REPEAT_PENALTY=0.5
QQBOT_MEMORY_INTERFERENCE_RATE=0.05

# Engineering policies remain independent of retrieval and activation.
QQBOT_MEMORY_COMPRESSION_ACTIVATION=0.2
QQBOT_MEMORY_COMPRESSION_MIN_CHARS=80
QQBOT_MEMORY_MERGE_SIMILARITY=0.9
QQBOT_MEMORY_MERGE_MAX_CHARS=600
QQBOT_MEMORY_FORGETTING_THRESHOLD=0.05
QQBOT_MEMORY_LOW_VALUE_THRESHOLD=0.2
QQBOT_MEMORY_PERMANENT_STRENGTH=31536000
QQBOT_MEMORY_PERMANENT_MIN_USES=20
QQBOT_MEMORY_FORGET_ENABLED=0
