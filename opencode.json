{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "minecraft-bot": {
      "type": "local",
      "command": ["npx", "-y", "minecraft-mcp-server", "--host", "localhost", "--port", "25565", "--username", "UnderlineBot"],
      "enabled": false
    },
    "minecraft-mod": {
      "type": "local",
      "command": ["npx", "-y", "minecraft-mod-mcp"],
      "enabled": true
    },
    "zai-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "env": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_BASE_URL": "https://api.siliconflow.cn/v1/",
        "Z_AI_VISION_MODEL": "zai-org/GLM-4.5V"
      },
      "enabled": true
    }
  }
}
