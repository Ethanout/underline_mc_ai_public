{
  "manifest_version": 2,
  "id": "underline.underline-tools",
  "version": "1.0.0",
  "name": "Underline 工具",
  "description": "查群里的技巧库、聊天记录和精华；把 /毯 任务让给毯毯的工具服务",
  "author": {
    "name": "Underline",
    "url": "https://github.com/Ethanout"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/Ethanout"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "config.get",
    "chat.get_group_streams",
    "chat.get_stream_by_group_id",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
